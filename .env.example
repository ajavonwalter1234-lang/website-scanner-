# Development credentials for local use only; generate random values before hosting.
SCANNER_API_TOKENS={"dev-local-token-change-me-123456":"local-user"}
SCANNER_PROXY_KEY=replace-with-a-random-secret-of-at-least-32-characters
REQUIRE_DOMAIN_VERIFICATION=false
ZAP_BASELINE_ENABLED=false
ZAP_BASELINE_COMMAND=zap-baseline.py
ZAP_BASELINE_TIMEOUT_SECONDS=75
SCAN_TIMEOUT_SECONDS=180
MAX_RESPONSE_BYTES=524288

# Production-only examples for docker-compose.production.yml
# APP_ENV=production
# POSTGRES_USER=scanner
# POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
# POSTGRES_DB=scanner
